{
  "name": "@appsys/devtool",
  "private": true,
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel --filter @appsys/devtool-server --filter @appsys/devtool-ui dev",
    "dev:ui": "pnpm --filter @appsys/devtool-ui dev",
    "dev:server": "pnpm --filter @appsys/devtool-server dev",
    "dev:cli": "pnpm --filter @appsys/devtool-cli dev",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
