{
  "name": "@appsys-sas/devtool-server",
  "version": "1.0.2",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AppSys-SAS/devtool.git",
    "directory": "apps/server"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch --conditions=development src/dev.ts",
    "dev:lb": "tsx --conditions=development src/dev-lb.ts"
  },
  "dependencies": {
    "@appsys-sas/devtool-auth": "workspace:*",
    "@appsys-sas/devtool-certs": "workspace:*",
    "@appsys-sas/devtool-config": "workspace:*",
    "@appsys-sas/devtool-environment": "workspace:*",
    "@appsys-sas/devtool-git": "workspace:*",
    "@appsys-sas/devtool-mcp": "workspace:*",
    "@appsys-sas/devtool-shared": "workspace:*",
    "@appsys-sas/devtool-skills": "workspace:*",
    "@iconify-json/akar-icons": "^1.2.7",
    "@iconify-json/bxl": "^1.2.4",
    "@iconify-json/devicon": "^1.2.81",
    "@iconify-json/flowbite": "^1.2.7",
    "@iconify-json/lineicons": "^1.2.6",
    "@iconify-json/logos": "^1.2.20",
    "@iconify-json/lucide": "^1.2.155",
    "@iconify-json/material-icon-theme": "^1.2.77",
    "@iconify-json/material-symbols": "^1.2.100",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.102",
    "@iconify-json/tabler": "^1.2.46",
    "@iconify-json/vscode-icons": "^1.2.99",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@lydell/node-pty": "^1.1.0",
    "@xterm/headless": "^6.0.0",
    "croner": "^11.0.1",
    "dns-packet": "^5.6.1",
    "mime-types": "^3.0.2",
    "tree-kill": "^1.2.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
