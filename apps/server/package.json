{
  "name": "@appsys/devtool-server",
  "version": "0.1.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/dev.ts"
  },
  "dependencies": {
    "@appsys/devtool-config": "workspace:*",
    "@appsys/devtool-shared": "workspace:*",
    "http-proxy": "^1.18.1",
    "mime-types": "^3.0.2",
    "node-pty": "^1.1.0",
    "tree-kill": "^1.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.17",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.11"
  }
}
