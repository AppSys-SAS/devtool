{
  "name": "@appsys/devtool-server",
  "version": "0.1.1",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm run \"/^dev:/\"",
    "dev:server": "tsx watch src/dev.ts",
    "dev:lb": "tsx src/dev-lb.ts"
  },
  "dependencies": {
    "@appsys/devtool-cdn": "workspace:*",
    "@appsys/devtool-config": "workspace:*",
    "@appsys/devtool-shared": "workspace:*",
    "dns-packet": "^5.6.1",
    "http-proxy": "^1.18.1",
    "mime-types": "^3.0.2",
    "node-pty": "^1.1.0",
    "tree-kill": "^1.2.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "@types/http-proxy": "^1.17.17",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  }
}
