{
  "name": "@appsys-sas/devtool",
  "version": "0.1.1",
  "description": "A local development environment: one server running your projects, their terminals and their shared environment, with a web interface.",
  "license": "Apache-2.0",
  "homepage": "https://appsys-sas.github.io/devtool/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AppSys-SAS/devtool.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "devtool": "./lib/index.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@appsys-sas/devtool-auth": "workspace:*",
    "@appsys-sas/devtool-config": "workspace:*",
    "@appsys-sas/devtool-environment": "workspace:*",
    "@appsys-sas/devtool-proxy": "workspace:*",
    "@appsys-sas/devtool-server": "workspace:*",
    "@appsys-sas/devtool-shared": "workspace:*",
    "@appsys-sas/devtool-skills": "workspace:*",
    "@appsys-sas/devtool-ui": "workspace:*",
    "@inquirer/prompts": "^8.7.4",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15"
  }
}
